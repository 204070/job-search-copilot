// Curated job sources. Committed example: edit freely, then run
//   python3 -m db.seed              # upsert by name (idempotent)
//   python3 -m db.seed --prune      # also disable boards missing from this file
// A fresh clone starts from THIS file — no two checkouts need the same boards.
//
// Per board: name (stable key; add_job.py and --board match on it),
// kind (job_board | careers_page | rss | referral | agency | other),
// scan_strategy (rss | jobspy | api | html | manual | disabled),
// scan_config (strategy settings), enabled (0/1), url, notes.
{
  "boards": [
    {
      "name": "We Work Remotely",
      "kind": "job_board",
      "url": "https://weworkremotely.com/",
      "enabled": 1,
      "notes": "Remote jobs in design, programming, marketing and more. Three category feeds (programming, full-stack, devops/sysadmin) under one board row; a posting listed in two categories is stored once.",
      "scan_strategy": "rss",
      "scan_config": {
        "feed_urls": [
          "https://weworkremotely.com/categories/remote-programming-jobs.rss",
          "https://weworkremotely.com/categories/remote-full-stack-programming-jobs.rss",
          "https://weworkremotely.com/categories/remote-devops-sysadmin-jobs.rss"
        ]
      }
    },
    {
      "name": "Levels.fyi",
      "kind": "job_board",
      "url": "https://www.levels.fyi/jobs",
      "enabled": 1,
      "notes": "Salaries & Tools to Level Up Your Career",
      "scan_strategy": "html",
      "scan_config": {}
    },
    {
      "name": "Remotive",
      "kind": "job_board",
      "url": "https://remotive.com/",
      "enabled": 1,
      "notes": null,
      "scan_strategy": "api",
      "scan_config": { "source": "remotive", "endpoint": "https://remotive.com/api/remote-jobs?category=software-dev" }
    },
    {
      "name": "Jobicy",
      "kind": "job_board",
      "url": "https://jobicy.com/",
      "enabled": 1,
      "notes": "Public JSON API. `jobGeo` states the region per posting (\"Anywhere\" / \"USA\" / country lists), which the region-scope tag reads directly.",
      "scan_strategy": "api",
      "scan_config": {
        "source": "mapped",
        "endpoint": "https://jobicy.com/api/v2/remote-jobs?count=50",
        "items": "jobs",
        "source_ref": "id",
        "fields": {
          "title": "jobTitle",
          "company": "companyName",
          "url": "url",
          "location": "jobGeo",
          "description": "jobDescription",
          "posted_at": "pubDate"
        }
      }
    },
    {
      "name": "Crossover",
      "kind": "job_board",
      "url": "https://www.crossover.com/",
      "enabled": 1,
      "notes": "SPA fallback at /feed + bot wall; manual",
      "scan_strategy": "manual",
      "scan_config": {}
    },
    {
      "name": "Relocate.me",
      "kind": "job_board",
      "url": "https://relocate.me/",
      "enabled": 1,
      "notes": "Software Developer Jobs in Germany w/ Relocation Packages",
      "scan_strategy": "html",
      "scan_config": {}
    },
    {
      "name": "Cleverjobs",
      "kind": "job_board",
      "url": "https://cleverjobs.net/",
      "enabled": 0,
      "notes": "Unreachable from this host; disabled",
      "scan_strategy": "html",
      "scan_config": {}
    },
    {
      "name": "Google Search: lever/greenhouse/ashbyhq/dover",
      "kind": "other",
      "url": "https://www.google.com/search?q=site%3Alever.co+%7C+site%3Agreenhouse.io+%7C+site%3Ajobs.ashbyhq.com+%7C+site%3Aapp.dover.io+%28engineer+%7C+developer%29+-remote+after%3A2022-08-15",
      "enabled": 1,
      "notes": "site:lever.co | site:greenhouse.io | site:jobs.ashbyhq.com | site:app.dover.io (engineer | developer) -remote after:2022-08-15",
      "scan_strategy": "manual",
      "scan_config": {}
    },
    {
      "name": "RemoteAfrica",
      "kind": "job_board",
      "url": "https://remoteafrica.io/",
      "enabled": 1,
      "notes": "Dormant board; manual",
      "scan_strategy": "manual",
      "scan_config": {}
    },
    {
      "name": "Remote4Africa",
      "kind": "job_board",
      "url": "https://remote4africa.com/",
      "enabled": 1,
      "notes": "Jobs behind a paywall; manual",
      "scan_strategy": "manual",
      "scan_config": {}
    },
    {
      "name": "Real Work From Anywhere",
      "kind": "job_board",
      "url": "https://www.realworkfromanywhere.com/",
      "enabled": 1,
      "notes": "Feed verified live; XML repaired by scanner",
      "scan_strategy": "rss",
      "scan_config": { "feed_url": "https://www.realworkfromanywhere.com/rss.xml" }
    },
    {
      "name": "Wellfound",
      "kind": "job_board",
      "url": "https://wellfound.com/jobs",
      "enabled": 1,
      "notes": null,
      "scan_strategy": "html",
      "scan_config": {}
    },
    {
      "name": "80,000 Hours",
      "kind": "job_board",
      "url": "https://jobs.80000hours.org/",
      "enabled": 1,
      "notes": "Job board | 80,000 Hours",
      "scan_strategy": "html",
      "scan_config": {}
    },
    {
      "name": "gojobs.run",
      "kind": "job_board",
      "url": "https://gojobs.run/",
      "enabled": 1,
      "notes": "Golang Jobs Updated Daily",
      "scan_strategy": "html",
      "scan_config": {}
    },
    {
      "name": "Dover Startup Jobs",
      "kind": "job_board",
      "url": "https://app.dover.com/startup-jobs",
      "enabled": 1,
      "notes": null,
      "scan_strategy": "html",
      "scan_config": {}
    },
    {
      "name": "RemoteOK",
      "kind": "job_board",
      "url": "https://remoteok.com/",
      "enabled": 1,
      "notes": "Public JSON API (RSS feed retired by RemoteOK). Tag=dev keeps it technical. Credit + link back per ToS.",
      "scan_strategy": "api",
      "scan_config": { "source": "remoteok", "endpoint": "https://remoteok.com/api?tags=dev" }
    },
    {
      "name": "Himalayas",
      "kind": "job_board",
      "url": "https://himalayas.app/",
      "enabled": 1,
      "notes": "Large mixed remote feed; keyword scoring filters non-tech postings.",
      "scan_strategy": "rss",
      "scan_config": { "feed_url": "https://himalayas.app/jobs/rss" }
    },
    {
      "name": "Indeed (JobSpy)",
      "kind": "job_board",
      "url": "https://www.indeed.com/",
      "enabled": 1,
      "notes": "Scraped via JobSpy; search_term tuned to the senior fullstack profile.",
      "scan_strategy": "jobspy",
      "scan_config": { "source": "indeed", "search_term": "senior software engineer", "location": "Remote", "results_wanted": 40, "hours_old": 36 }
    },
    {
      "name": "ZipRecruiter (JobSpy)",
      "kind": "job_board",
      "url": "https://www.ziprecruiter.com/",
      "enabled": 1,
      "notes": "Scraped via JobSpy.",
      "scan_strategy": "jobspy",
      "scan_config": { "source": "zip_recruiter", "search_term": "senior software engineer", "location": "Remote", "results_wanted": 30, "hours_old": 36 }
    },
    {
      "name": "LinkedIn (JobSpy)",
      "kind": "job_board",
      "url": "https://www.linkedin.com/jobs/",
      "enabled": 1,
      "notes": "Scraped via JobSpy; LinkedIn rate-limits bursts (results kept low).",
      "scan_strategy": "jobspy",
      "scan_config": { "source": "linkedin", "search_term": "senior software engineer", "location": "Remote", "results_wanted": 25, "hours_old": 36 }
    },
    {
      "name": "Jobspresso",
      "kind": "job_board",
      "url": "https://jobspresso.co/",
      "enabled": 1,
      "notes": "Verified dev-category WP Job Manager feed; company and location ride in job_listing:* tags and the body in content:encoded.",
      "scan_strategy": "rss",
      "scan_config": {
        "feed_url": "https://jobspresso.co/?feed=job_feed&job_listing_category=programming"
      }
    },
    {
      "name": "X Bookmarks",
      "kind": "other",
      "url": "https://x.com/i/bookmarks",
      "enabled": 1,
      "notes": "Own X bookmarks via logged-in Chrome (x_bookmarks_cli) or Playwright fallback (x_bookmarks, profile in secrets/). `on_demand` keeps it off a full run: it reads the user's own X session through a browser they are driving, so it is scanned only when named (`python3 -m scanner --board 'X Bookmarks'`). Run python3 -m scanner.tools.x_login once, and again if the scan log reports an expired session or Cloudflare challenge.",
      // YOUR OpenCLI profile id for the X-logged-in Chrome — change on a fresh clone
      "scan_strategy": "html",
      "scan_config": { "mode": "x_bookmarks_cli", "profile": "g3pxjge8", "cap": 50, "on_demand": true }
    },
    {
      "name": "JS Guru Jobs",
      "kind": "job_board",
      "url": "https://jsgurujobs.com/jobs",
      "enabled": 1,
      "notes": "Server-rendered JS job list (10 per page). The card's country span is the employer's place and its Remote/Worldwide badges are the eligibility, so a Worldwide badge is what the region tag reads; the place rides in metadata. The advert lives on the posting's own page: `details` reads it, but only for postings the store has no text for yet, and that page's Posted date replaces the card's age.",
      "scan_strategy": "html",
      "scan_config": { "mode": "jsgurujobs", "pages": 3, "details": true }
    },
    {
      "name": "JavaScript Jobs",
      "kind": "job_board",
      "url": "https://javascript.jobs/jobs",
      "enabled": 1,
      "notes": "Server-rendered JS job list (18 per page). Card carries title, employer, place and age only; the posting page carries a JobPosting JSON-LD with the advert, the posted date and the employment type, which `details` reads for postings the store has no text for yet.",
      "scan_strategy": "html",
      "scan_config": { "mode": "javascript_jobs", "pages": 2, "details": true }
    },
    {
      "name": "HiringCafe",
      "kind": "job_board",
      "url": "https://hiringcafe.com/",
      "enabled": 1,
      "notes": "Cloudflare 403s plain requests, so the search page is read from your own Chrome through OpenCLI's Browser Bridge (scanner/js/hiringcafe_search.js, mode opencli_eval). The search below is the user's own: query 'software', workplace types Remote/Hybrid/Field, sorted by date; page 1 is 120 rows. Needs Chrome open, like X Bookmarks. Rows carry the employer's own apply_url, so dedupe lands on the real posting.",
      "scan_strategy": "html",
      "scan_config": {
        "mode": "opencli_eval",
        "profile": "g3pxjge8",
        "session": "jobfit",
        // YOUR search, exactly as the HiringCafe URL encodes it
        "url": "https://hiringcafe.com/classic?searchState=%7B%22searchQuery%22%3A%22software%22%2C%22workplaceTypes%22%3A%5B%22Remote%22%2C%22Hybrid%22%2C%22Field%22%5D%2C%22defaultToUserLocation%22%3Afalse%2C%22sortBy%22%3A%22date%22%7D",
        "js_file": "hiringcafe_search.js",
        "tries": 10,
        "wait_ms": 3000
      }
    },
    {
      "name": "Manual",
      "kind": "other",
      "url": null,
      "enabled": 1,
      "notes": "Hand-added leads (python3 -m scanner.tools.add_job). scan_strategy=manual keeps scans away.",
      "scan_strategy": "manual",
      "scan_config": {}
    }
  ]
}
