// Scoring config for the keyword matcher (scanner/keywords.py).
//
// Two title rules decide whether a posting is scored at all:
//
//   title_admit    the title must match at least one of these regexes.
//   title_exclude  any match vetoes the posting outright, so a "Support
//                  Engineer" whose advert mentions Kubernetes still scores 0.
//                  Excludes are checked first, so they always win.
//
// Then: score = 100 x matched weight / target, capped at 99, where `target` is
// the weight of the entries at or above `core_weight`. The point of a target
// is that the long tail extends the scale instead of compressing it: adding
// another incidental term must not lower everyone's score. Matching the whole
// core tier is a full score. Weights: 3 = the verified strengths, 2 = verified
// and used in production but supporting, 1 = incidental or side-project
// territory. Tune `core_weight` or any weight freely.
//
// The old shape was a fixed list of nine title phrasings as the gate, plus
// unweighted coverage over the whole list. It sent whole role families to 0:
// "Senior Frontend Engineer, React/Typescript" matched no gate phrase, so two
// of the person's strongest languages counted for nothing, and 383 of 455
// bookmarked postings scored 0.
//
// Edits apply on the next scan. Stored match_score values are historical until
// `python3 -m scanner.tools.rescore` re-derives them.
{
  "title_admit": [
    "\\bengineer\\b",
    "\\bengineering\\b",
    "\\bdeveloper\\b",
    "\\bprogrammer\\b",
    "\\barchitect\\b",
    "\\bsre\\b",
    "\\bfull[- ]?stack\\b",
    "\\bback[- ]?end\\b",
    "\\bfront[- ]?end\\b",
    // Engineering management, in scope on request. The general patterns above
    // do not admit it ("Engineering Manager" says engineering, and the exclude
    // half used to veto on `manager`), so it needs both halves changed.
    "\\bengineering manager\\b",
    "\\bmanager,? (?:of )?engineering\\b"
    // Also in scope and already admitted by the general patterns, listed here
    // so the target families are readable in one place: Product Engineer,
    // Forward Deployed Engineer (engineer), Solutions Architect (architect),
    // AI Engineer, LLM Engineer (engineer).
  ],
  "title_exclude": [
    "sales engineer",
    "support engineer",
    "solutions engineer",
    "solution engineer",
    "customer engineer",
    "field engineer",
    "service desk",
    "technical support",
    "technical account",
    "customer success",
    "developer relations",
    "developer advocate",
    "devrel",
    "product manager",
    "project manager",
    "program manager",
    "product owner",
    // Engineering management is a target role, so the blanket `\bmanager\b`
    // veto is gone and the kinds of manager that stay out are named. Without
    // the blanket rule the admit half still has to match, which is what keeps
    // "Community Manager" and "Office Manager" out on their own.
    "account manager",
    "delivery manager",
    "office manager",
    "community manager",
    "social media",
    "scrum master",
    "recruit",
    // Leadership above first-line management, not asked for: director, VP,
    // chief, president, head of.
    "\\bdirector\\b",
    "\\bvp\\b",
    "head of",
    "\\bchief\\b",
    "\\bpresident\\b",
    "marketing",
    "\\bsales\\b",
    "account executive",
    "business development",
    "partnerships",
    "recruiter",
    "talent",
    "sourcer",
    "designer",
    // Adjacent platforms that read as engineering but not this person's: the
    // targets are web fullstack, backend and platform.
    "react native",
    "flutter",
    "android",
    "\\bios\\b",
    "salesforce",
    "servicenow",
    "workday",
    "sharepoint",
    "data scientist",
    "data analyst",
    "business analyst",
    "\\bqa\\b",
    "quality assurance",
    "test engineer",
    "technical writer",
    "documentation engineer",
    "accountant",
    "compliance officer"
  ],
  "core_weight": 3,
  "keywords": [
    { "term": "typescript", "weight": 3, "enabled": 1 },
    { "term": "node", "weight": 3, "enabled": 1 },
    { "term": "nestjs", "weight": 3, "enabled": 1 },
    { "term": "bun", "weight": 3, "enabled": 1 },
    { "term": "react", "weight": 3, "enabled": 1 },
    { "term": "python", "weight": 3, "enabled": 1 },
    { "term": "postgres", "weight": 3, "enabled": 1 },
    { "term": "redis", "weight": 3, "enabled": 1 },

    { "term": "javascript", "weight": 2, "enabled": 1 },
    { "term": "django", "weight": 2, "enabled": 1 },
    { "term": "graphql", "weight": 2, "enabled": 1 },
    { "term": "mongodb", "weight": 2, "enabled": 1 },
    { "term": "mssql", "weight": 2, "enabled": 1 },
    { "term": "supabase", "weight": 2, "enabled": 1 },
    { "term": "aws", "weight": 2, "enabled": 1 },
    { "term": "azure", "weight": 2, "enabled": 1 },
    { "term": "gcp", "weight": 2, "enabled": 1, "pattern": "gcp|google cloud" },
    { "term": "terraform", "weight": 2, "enabled": 1 },
    { "term": "ansible", "weight": 2, "enabled": 1 },
    { "term": "docker", "weight": 2, "enabled": 1 },
    { "term": "kubernetes", "weight": 2, "enabled": 1 },
    { "term": "github actions", "weight": 2, "enabled": 1 },
    { "term": "next.js", "weight": 2, "enabled": 1, "pattern": "next[. ]?js" },
    { "term": "websocket group", "weight": 2, "enabled": 1,
      "pattern": "websocket|web sockets|realtime|real-time" },

    // AI engineering, added 18/10 because the role families of interest now
    // include AI Engineer and LLM Engineer and the scorer was blind to all of
    // it: an ad naming RAG, LLMs and agents matched nothing on this list.
    // Weight 2 rather than 3: the work is real (AI agents in a shipped
    // product) but newer than the production core.
    { "term": "ai", "weight": 2, "enabled": 1,
      "pattern": "\\bai\\b|artificial intelligence|generative ai|\\bgenai\\b" },
    { "term": "llm", "weight": 2, "enabled": 1,
      "pattern": "\\bllms?\\b|large language models?" },
    { "term": "rag", "weight": 2, "enabled": 1,
      "pattern": "\\brag\\b|retrieval[- ]augmented" },

    // Location affinity rather than stack. A posting that names your country
    // or your city is telling you it will hire where you are, which is worth
    // knowing in the score as well as in `region_scope` (where Lagos and
    // Nigeria already rank in the covering band).
    { "term": "nigeria", "weight": 2, "enabled": 1 },
    { "term": "lagos", "weight": 2, "enabled": 1 },

    { "term": "rust", "weight": 1, "enabled": 1 },
    { "term": "golang", "weight": 1, "enabled": 1 },
    { "term": "java", "weight": 1, "enabled": 1 },
    { "term": "dotnet group", "weight": 1, "enabled": 1, "pattern": "c#|\\.net" },
    { "term": "spring boot", "weight": 1, "enabled": 1, "pattern": "spring\\s?boot" },
    { "term": "fastify", "weight": 1, "enabled": 1 },
    { "term": "cassandra", "weight": 1, "enabled": 1 },
    { "term": "clickhouse", "weight": 1, "enabled": 1 },
    { "term": "pulumi", "weight": 1, "enabled": 1 },
    { "term": "jenkins", "weight": 1, "enabled": 1 },
    { "term": "grafana", "weight": 1, "enabled": 1 },
    { "term": "kafka", "weight": 1, "enabled": 1 },
    { "term": "cloudflare", "weight": 1, "enabled": 1 },
    { "term": "heroku", "weight": 1, "enabled": 1 },
    { "term": "vercel", "weight": 1, "enabled": 1 },
    { "term": "netlify", "weight": 1, "enabled": 1 },
    { "term": "nginx", "weight": 1, "enabled": 1 },
    { "term": "linux", "weight": 1, "enabled": 1 }
  ]
}
